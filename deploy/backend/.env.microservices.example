# ====== 微服务环境变量示例 ======
# 复制为 .env 并修改为你的实际配置

# MySQL（所有微服务共用同一 MySQL 实例，但各自独立数据库）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_CHARSET=utf8mb4

# 各服务独立数据库名（迁移脚本会自动创建这些库）
AUTH_DB=lc_auth
USER_DB=lc_user
CHAT_DB=lc_chat
KB_DB=lc_kb
ADMIN_DB=lc_admin

# 各服务端口（nginx 按这些端口路由）
AUTH_PORT=8001
USER_PORT=8002
CHAT_PORT=8003
KB_PORT=8004
ADMIN_PORT=8005
FILE_PORT=8006

# 内部调用地址（服务间互调用走 127.0.0.1）
INTERNAL_HOST=127.0.0.1

# JWT 共享密钥（所有服务必须一致，否则跨服务 token 验证失败）
JWT_SECRET_KEY=lc-course-secret-key-2025
JWT_TOKEN_EXPIRE_HOURS=72

# 管理员 IP 白名单（逗号分隔，留空则不限制）
ADMIN_ALLOWED_IPS=
