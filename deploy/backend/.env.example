# ====== 生产环境配置 ======
# 复制此文件为 .env 并修改

# 不挂载前端静态文件（由 nginx 提供前端服务）
SERVE_STATIC=false

# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=lc_course

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DashScope API 配置（阿里云）
DASHSCOPE_API_KEY=your_dashscope_api_key

# Tavily API 配置（联网搜索）
TAVILY_API_KEY=your_tavily_api_key

# ChromaDB 持久化目录
CHROMA_PERSIST_DIRECTORY=./chroma_ab

# 服务端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
